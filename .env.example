MOONSTAR_GATEWAY_URL=http://localhost:8000
# token: bash moonstar-rs/scripts/harness.sh token (from the workbench root)
MOONSTAR_AUTH_TOKEN=
# default provider is local ACE-Step (free): uv run acestep-api in D:/dev/ACE-Step-1.5
ACESTEP_URL=http://localhost:8001
ACESTEP_API_KEY=
# only needed if providers.json selects elevenlabs_music
ELEVENLABS_API_KEY=
MINIMAX_API_KEY=
PUBLISH_ENABLED=false
PUBLISH_PRIVACY=private
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
LOOP_INTERVAL_SECONDS=21600
MAX_TRACKS_PER_DAY=4
CYCLE_MAX_USD=1.00
OUTPUT_DIR=./data
LOG_LEVEL=INFO
